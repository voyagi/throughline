# Copy to .env for local development. Never commit .env.
# Every value here has a working local default except the ones marked OWNER, which need a cloud
# account. The app starts and the memory layer works with the local defaults alone.

# --- Database ---------------------------------------------------------------
# Local Docker single node. For CockroachDB Cloud, paste the connection string from the console.
DATABASE_URL=postgresql://root@127.0.0.1:26257/throughline?sslmode=disable

# --- Embeddings -------------------------------------------------------------
# local  = deterministic hash embedding, no network, used by tests and offline development
# bedrock = AWS Bedrock, requires the AWS settings below
EMBEDDING_PROVIDER=local
# Read the real value from the live account, never assume it:
#   aws bedrock list-foundation-models --region eu-central-1
EMBEDDING_MODEL_ID=
# Must match what the model actually returns. The capability probe compares this against the
# column definition and refuses to start on a mismatch rather than writing truncated vectors.
EMBEDDING_DIMENSIONS=1024

# --- Agent model ------------------------------------------------------------
# local  = scripted responses, no network, deterministic, used by tests and the canned demo
# bedrock = AWS Bedrock
AGENT_PROVIDER=local
AGENT_MODEL_ID=

# --- AWS (OWNER) ------------------------------------------------------------
AWS_REGION=eu-central-1

# --- CockroachDB Cloud managed MCP server (OWNER) ---------------------------
# Used for the independent verification channel and the operator plane, never for the hot path.
# In AWS this arrives from Secrets Manager through the execution role. Locally it can sit here.
CRDB_MCP_URL=https://cockroachlabs.cloud/mcp
CRDB_MCP_API_KEY=
CRDB_MCP_CLUSTER_ID=

# --- Demo safety ------------------------------------------------------------
# Hard caps so a public demo cannot run up a bill. These will be enforced in code rather than in a
# dashboard. The enforcement lands with the API, so today these two values are read by nothing.
DEMO_MAX_AGENT_CALLS_PER_DAY=500
DEMO_RATE_LIMIT_PER_MINUTE=10
