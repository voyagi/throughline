{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
    // The root tsconfig excludes this workspace, because `tsc` cannot read `.astro` files at all.
    // What type-checks this app is `astro check`, and it is wired into `verify:ship` as its own
    // step for exactly that reason: a check nobody runs is not a check.
    //
    // No `types` override here. Setting one replaces the automatic inclusion of every `@types`
    // package rather than adding to it, which is a quiet way to remove checking you believe you
    // still have.
  }
}
