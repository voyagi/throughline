# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
.astro/
build/
cdk.out/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
# Also the <name>.env form. `.env` and `.env.*` do NOT match `prod.env` or `production.env`, which
# is a common enough naming convention that the gap is worth closing in a repo that goes public
# while a real credential file sits in the working directory. Verified with git rather than by
# reading the rule: `git check-ignore secrets/prod.env` reported NOT ignored before this line.
*.env
!.env.example
*.pem
*.key
# The cluster CA cert is not itself a secret, but this repo goes public and every entrant needs
# their own. A stray root.crt in the tree would otherwise be committable: *.pem and *.key do not
# match it.
*.crt

# Local database state
.cockroach-data/

# Test and tool output
coverage/
.nyc_output/
.stryker-tmp/
reports/
playwright-report/
test-results/
.jscpd/

# AI tooling working directories. Also listed in .git/info/exclude, but that file is per-clone and
# never travels, so a fresh clone would have no protection at all without these lines.
.claude/
.codex/
.agents/
.planning/
.crash-buffers/
design/_scratch/
# Read from disk by a local hook. The filename itself is vocabulary from a private build system,
# so it stays out of a repo that becomes public.
.build-lane

# Editor and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
