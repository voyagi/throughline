.claude/
.codex/
.agents/
.planning/
.crash-buffers/
design/_scratch/
# Read from disk by a local hook. The filename itself is vocabulary from a private build system,
# so it stays out of a repo that becomes public.
.build-lane

# Editor and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

